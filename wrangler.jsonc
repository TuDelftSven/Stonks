{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stonks-portfolio",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stonks_d1",
      "database_id": "4acec709-835b-40ab-acf9-4084b89f6cd4",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "stonks-portfolio-data"
    }
  ],
  "observability": {
    "enabled": true
  }
}
